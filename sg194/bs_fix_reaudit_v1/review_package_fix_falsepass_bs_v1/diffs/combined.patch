+            reduction.get("endpoint_pair_skeleton_row_rank", 0)
+        ),
+        "augmentation_path_class_ids": augmentation_ids,
+        "augmentation_witnesses": witness_entries,
+        "baseline_rref_basis_rows": _rref_basis_rows(pair_skeleton_rows),
